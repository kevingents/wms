# ─────────────────────────────────────────────────────────────────────────────
# GENTS WMS — environment. Kopieer naar .env.local en vul in. NOOIT committen.
#
# Huisregel: alleen SECRETS en platform-config staan hier. Alle instelbare
# waarden (drempels, zones, looproute, cutoffs) horen in de tool zelf — tabel
# `wms.settings`, bewerkbaar via /instellingen.
# ─────────────────────────────────────────────────────────────────────────────

# Neon Postgres. Gebruik de POOLED connection string (…-pooler.…) uit Neon.
# Zelfde Neon-project als de commerce-core; het WMS leeft in schema `wms`.
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Secret waarmee de httpOnly sessie-cookie (JWT/HS256) wordt getekend.
# Zet dezelfde waarde als in storeportal_next zodra WMS en portal onder één
# domein draaien; anders een eigen lange random string.
#   openssl rand -base64 48
SESSION_SECRET=

# Optioneel: cookie-naam override (default: gents_wms_session)
# SESSION_COOKIE_NAME=gents_wms_session

# Backend (storegents serverless-API). Server-only. Wordt gebruikt voor:
#   - personeel-login (api/srs/personnel/login)
#   - de SRS-voorraadspiegel tijdens de shadow-fase
BACKEND_API_BASE=https://storegents.vercel.app

# Admin-token van de storegents-backend. SERVER-ONLY — nooit NEXT_PUBLIC_.
ADMIN_TOKEN=

# Cron-secret voor de nachtelijke SRS-vergelijking (Vercel Cron stuurt deze mee).
CRON_SECRET=
